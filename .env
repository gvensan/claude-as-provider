# Copy to .env. Read by scripts/dev.sh for both ccgw and the LiteLLM proxy.

# --- ccgw (Claude Code behind an OpenAI-compatible API) ---
CCGW_PORT=9991
CCGW_MODEL_NAME=claude-code      # the model id ccgw advertises
CCGW_CLAUDE_MODEL=sonnet         # model Claude Code actually runs: sonnet, opus, haiku, or a full id
CCGW_EFFORT=                     # optional: low|medium|high|xhigh|max
CCGW_MAX_CONCURRENCY=8           # parallel Claude Code processes (raising it does not lift Anthropic limits)
CCGW_TIMEOUT_SECONDS=300
CCGW_RATE_LIMIT_RETRIES=2        # retries inside ccgw when Anthropic throttles
CCGW_RATE_LIMIT_MAX_WAIT_SECONDS=30   # longer than this: return 429 + Retry-After instead
CCGW_RATE_LIMIT_BACKOFF_SECONDS=5     # first retry delay, doubles each retry
CCGW_API_KEY=sk-ccgw-local       # LiteLLM uses this to reach ccgw

# --- LiteLLM proxy (what callers point at) ---
LITELLM_HOST=127.0.0.1           # set 0.0.0.0 if callers run in Docker (use host.docker.internal there)
LITELLM_PORT=4444
LITELLM_MASTER_KEY=sk-litellm-local   # the "API Key" callers send
